# Copy to .env next to docker-compose.yml and fill in.

# The one password for /admin. Changing it signs every phone out.
ADMIN_PASSWORD=

# Used for links in calendar files, the sitemap and link previews.
SITE_URL=https://tommybmusic.co.uk

# Optional: email each booking enquiry to the booking address.
# Leave SMTP_HOST empty and enquiries are only stored (they're always in /admin).
# mail.com: smtp.mail.com, port 587, the full address and its password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER.
SMTP_FROM=
